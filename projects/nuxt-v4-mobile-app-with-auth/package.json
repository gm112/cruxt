    "lint": "eslint .",
    "format": "eslint . --fix",
    "deploy:deno": "mv .output ../../"
  },
  "dependencies": {
    "@cruxt/auth": "workspace:*"
  },
  "devDependencies": {
    "nuxt": "catalog:"
  }
