{
  "name": "nuxt-v4-mobile-app-with-auth",
  "private": true,
  "type": "module",
  "config": {
    "environments": ["development"],
    "tags": ["internal"],
    "database_type": "postgresql",
    "cloud_provider": "none"
  },
  "scripts": {
